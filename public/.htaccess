Options -Indexes
RewriteEngine On

# Keep the PHP integration and generated assets on their real files.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# TanStack Start SPA shell for /leadgenerator routes such as /auth.
RewriteRule ^ _shell.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(_shell\.html|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
